{
    "environments": {
      "local": {
        "backend": {
          "host": "localhost",
          "port": 5000,
          "url": "http://localhost:5000"
        },
        "frontend": {
          "host": "localhost",
          "port": 8080,
          "url": "http://localhost:8080"
        },
        "marketo_agent": {
          "host": "localhost",
          "port": 10002,
          "url": "http://localhost:10002"
        },
        "websearch_agent": {
          "host": "localhost",
          "port": 10003,
          "url": "http://localhost:10003"
        },
        "mcp_server": {
          "host": "localhost",
          "port": 8002,
          "url": "http://localhost:8002"
        },
        "database": {
          "type": "sqlite",
          "url": "sqlite+aiosqlite:///./conversations.db"
        }
      },
      "production": {
        "backend": {
          "host": "0.0.0.0",
          "port": 8080,
          "url": "${BACKEND_URL}"
        },
        "frontend": {
          "host": "0.0.0.0",
          "port": 8080,
          "url": "${FRONTEND_URL}"
        },
        "marketo_agent": {
          "host": "0.0.0.0",
          "port": 8080,
          "url": "${MARKETO_AGENT_URL}"
        },
        "websearch_agent": {
          "host": "0.0.0.0",
          "port": 8080,
          "url": "${WEBSEARCH_AGENT_URL}"
        },
        "mcp_server": {
          "host": "0.0.0.0",
          "port": 8080,
          "url": "${MCP_SERVER_URL}"
        },
        "database": {
          "type": "postgresql",
          "url": "${SUPABASE_DATABASE_URL}"
        }
      }
    },
    "cors": {
      "local": ["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"],
      "production": ["${FRONTEND_URL}"]
    }
  }