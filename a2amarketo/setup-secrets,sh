#!/bin/bash

# Script to set up Google Cloud Secrets
# Usage: ./setup-secrets.sh

set -e

PROJECT_ID="your-gcp-project-id"  # Replace with your GCP project ID

echo "🔐 Setting up Google Cloud Secrets for A2A Marketo"
echo "Project: $PROJECT_ID"

gcloud config set project $PROJECT_ID

# Enable Secret Manager API
echo "Enabling Secret Manager API..."
gcloud services enable secretmanager.googleapis.com

# Create secrets (you'll be prompted to enter values)
echo ""
echo "Creating secrets... (You'll be prompted for each value)"

# Google API Key
echo "Enter GOOGLE_API_KEY:"
read -s GOOGLE_API_KEY
echo -n "$GOOGLE_API_KEY" | gcloud secrets create GOOGLE_API_KEY --data-file=-

# Marketo credentials
echo "Enter MARKETO_CLIENT_ID:"
read MARKETO_CLIENT_ID
echo -n "$MARKETO_CLIENT_ID" | gcloud secrets create MARKETO_CLIENT_ID --data-file=-

echo "Enter MARKETO_CLIENT_SECRET:"
read -s MARKETO_CLIENT_SECRET
echo -n "$MARKETO_CLIENT_SECRET" | gcloud secrets create MARKETO_CLIENT_SECRET --data-file=-

echo "Enter MARKETO_IDENTITY_BASE (e.g., https://your-instance.mktorest.com/identity):"
read MARKETO_IDENTITY_BASE
echo -n "$MARKETO_IDENTITY_BASE" | gcloud secrets create MARKETO_IDENTITY_BASE --data-file=-

echo "Enter MARKETO_REST_BASE (e.g., https://your-instance.mktorest.com/rest):"
read MARKETO_REST_BASE
echo -n "$MARKETO_REST_BASE" | gcloud secrets create MARKETO_REST_BASE --data-file=-

# JWT Secret Key
echo "Enter JWT_SECRET_KEY (generate a random string):"
read -s JWT_SECRET_KEY
echo -n "$JWT_SECRET_KEY" | gcloud secrets create JWT_SECRET_KEY --data-file=-

# Supabase Database URL
echo "Enter SUPABASE_DATABASE_URL (PostgreSQL connection string):"
read -s SUPABASE_DATABASE_URL
echo -n "$SUPABASE_DATABASE_URL" | gcloud secrets create SUPABASE_DATABASE_URL --data-file=-

echo ""
echo "✅ All secrets created successfully!"
echo ""
echo "To view secrets:"
echo "  gcloud secrets list"
echo ""
echo "To update a secret:"
echo "  echo -n 'new-value' | gcloud secrets versions add SECRET_NAME --data-file=-"